        // ==========================================
        function buildMasterNycAttractionsCatalog() {
            const scheduledNycAttractions = [];
            [3, 4, 5, 6, 7, 8].forEach(dayNum => {
                const stops = DEFAULT_DAYS_DATA[dayNum]?.stops || [];
                stops.forEach(s => {
                    // Exclude airport/hotel/pure logistics from attractions catalog if needed, or keep all NYC sites with coordinates
                    if (s.id === "d3-s2" || s.id === "d8-s4") return; // Skip Buffalo airport & JFK flight logistics
                    let area = "Midtown";
                    if (s.lat > 40.768) area = "Uptown";
                    else if (s.lat < 40.735) area = "Downtown";

                    scheduledNycAttractions.push({
                        id: s.id,
                        name: s.name,
                        area: area,
                        type: s.type,
                        address: s.address,
                        lat: s.lat,
                        lng: s.lng,
                        cost: s.cost || "חינם",
                        duration: s.time || "1-2 שעות",
                        recommendedDays: [dayNum],
                        matchReason: `משובץ בתוכנית המקורית של יום ${dayNum} (${DEFAULT_DAYS_DATA[dayNum].dayName}).`,
                        desc: s.desc,
                        tags: s.tags || [],
                        isCoreScheduled: true,
                        defaultDay: dayNum
                    });
                });
            });

            const extraFormatted = DEFAULT_EXTRA_ATTRACTIONS.map(ext => ({
                ...ext,
                isCoreScheduled: false,
                defaultDay: null
            }));

            return [...scheduledNycAttractions, ...extraFormatted];
        }

        const MASTER_NYC_ATTRACTIONS_DB = buildMasterNycAttractionsCatalog();

        // Helper: returns true if an attraction ID or name is currently scheduled in any NYC day (3-8)
        function isAttractionScheduledInTrip(attrItem) {
            for (let d = 3; d <= 8; d++) {
                const stops = appState.daysData[d]?.stops || [];
                if (stops.some(s => s.id === attrItem.id || s.name === attrItem.name)) {
                    return d;
                }
            }
            return null;
        }

        // Synchronize unscheduled NYC attractions from the unified DB into the drawer
        function getUnscheduledDrawerAttractions() {
            return MASTER_NYC_ATTRACTIONS_DB.filter(item => !isAttractionScheduledInTrip(item));
