<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>הזאבים בניו יורק והניאגרה 2026 | מתכנן טיול חכם</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <style>
        body {
            font-family: 'Heebo', sans-serif;
            background-color: #f8fafc;
            color: #0f172a;
        }
        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #f1f5f9;
            border-radius: 8px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 8px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
        #map-container {
            height: calc(100vh - 230px);
            min-height: 520px;
            width: 100%;
            border-radius: 1rem;
            z-index: 10;
        }
        .timeline-line::before {
            content: '';
            position: absolute;
            top: 1.5rem;
            bottom: 1.5rem;
            right: 1.35rem;
            width: 3px;
            background: linear-gradient(to bottom, #3b82f6, #6366f1, #cbd5e1);
            border-radius: 999px;
        }
        .card-hover {
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .card-hover:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.08);
        }
        .badge-pulse {
            animation: pulse-soft 2s infinite;
        }
        @keyframes pulse-soft {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.75; }
        }
    </style>
</head>
<body class="min-h-screen flex flex-col">

    <header class="bg-gradient-to-l from-slate-900 via-blue-950 to-slate-900 text-white sticky top-0 z-40 shadow-xl border-b border-blue-800/40">
        <div class="max-w-7xl mx-auto px-4 py-3 sm:px-6 flex flex-col md:flex-row md:items-center md:justify-between gap-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-11 h-11 rounded-2xl bg-gradient-to-br from-amber-400 to-orange-500 flex items-center justify-center text-slate-950 font-black text-xl shadow-lg shadow-amber-500/20">
                        <i class="fa-solid fa-wolf-pack-battalion"></i>
                    </div>
                    <div>
                        <div class="flex items-center gap-2">
                            <h1 class="text-lg sm:text-xl font-black tracking-tight">טיול הזאבים לניו יורק והניאגרה</h1>
                            <span class="bg-amber-500/20 text-amber-300 border border-amber-400/30 text-xs px-2 py-0.5 rounded-full font-semibold">8–15 בנובמבר 2026</span>
                        </div>
                        <p class="text-xs text-blue-200/80">מסלול מהודק • כשרות מוסמכת • ניווט Google Maps חי • מגירת אטרקציות חכמה</p>
                    </div>
                </div>
                <button onclick="openResetModal()" title="איפוס למסלול המקורי" class="md:hidden text-xs bg-slate-800 hover:bg-slate-700 text-slate-300 px-2.5 py-1.5 rounded-xl border border-slate-700">
                    <i class="fa-solid fa-rotate-left"></i>
                </button>
            </div>

            <!-- Main Navigation Tabs -->
            <nav class="flex items-center gap-1.5 overflow-x-auto pb-1 md:pb-0 no-scrollbar">
                <button onclick="switchMainTab('itinerary')" id="tab-btn-itinerary" class="main-tab-btn flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs sm:text-sm font-bold transition-all whitespace-nowrap bg-blue-600 text-white shadow-md shadow-blue-600/30">
                    <i class="fa-solid fa-route"></i>
                    <span>מסלול 8 הימים</span>
                </button>
                <button onclick="switchMainTab('restaurants')" id="tab-btn-restaurants" class="main-tab-btn flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs sm:text-sm font-bold transition-all whitespace-nowrap bg-slate-800/80 text-slate-300 hover:bg-slate-800">
                    <i class="fa-solid fa-utensils"></i>
                    <span>מסעדות כשרות</span>
                    <span class="bg-emerald-500/20 text-emerald-300 px-1.5 py-0.2 rounded-full text-[11px]" id="rest-count-badge">36</span>
                </button>
                <button onclick="switchMainTab('map')" id="tab-btn-map" class="main-tab-btn flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs sm:text-sm font-bold transition-all whitespace-nowrap bg-slate-800/80 text-slate-300 hover:bg-slate-800">
                    <i class="fa-solid fa-map-location-dot"></i>
                    <span>מפה חיה</span>
                </button>
                <button onclick="switchMainTab('centralpark')" id="tab-btn-centralpark" class="main-tab-btn flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs sm:text-sm font-bold transition-all whitespace-nowrap bg-slate-800/80 text-slate-300 hover:bg-slate-800">
                    <i class="fa-solid fa-tree"></i>
                    <span>סיור סנטרל פארק</span>
                </button>
                <button onclick="switchMainTab('guide')" id="tab-btn-guide" class="main-tab-btn flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs sm:text-sm font-bold transition-all whitespace-nowrap bg-slate-800/80 text-slate-300 hover:bg-slate-800">
                    <i class="fa-solid fa-compass"></i>
                    <span>מדריך, סאבווי ושבת</span>
                </button>
                <button onclick="openResetModal()" title="איפוס שינויים למסלול המקורי" class="hidden md:flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-semibold bg-slate-800/90 hover:bg-red-950/60 text-slate-300 hover:text-red-200 border border-slate-700 transition-all">
                    <i class="fa-solid fa-rotate-left"></i>
                    <span>איפוס מסלול</span>
                </button>
            </nav>
        </div>
    </header>

    <main class="flex-1 max-w-7xl w-full mx-auto px-3 sm:px-6 py-5">

        <!-- TAB 1: ITINERARY + SMART ATTRACTIONS DRAWER -->
        <section id="view-itinerary" class="space-y-5">
            <!-- Day Selector Bar -->
            <div class="bg-white p-2.5 rounded-2xl shadow-sm border border-slate-200/80">
                <div class="flex items-center justify-between mb-2 px-1">
                    <span class="text-xs font-bold text-slate-500 uppercase tracking-wider"><i class="fa-regular fa-calendar-check ml-1 text-blue-600"></i>בחירת יום בטיול:</span>
                    <span class="text-xs text-slate-500 hidden sm:inline">ניתן לשנות סדר תחנות, להוסיף אטרקציות מהמגירה ולפתוח מסלול ישיר ב-Google Maps</span>
                </div>
                <div id="day-selector-container" class="grid grid-cols-4 sm:grid-cols-8 gap-1.5">
                    <!-- Populated via JS -->
                </div>
            </div>

            <!-- Split Layout: Right = Day Timeline (7 cols), Left = Smart Drawer (5 cols on lg) -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
                
                <!-- Right Column: Active Day Detailed Schedule -->
                <div class="lg:col-span-7 xl:col-span-8 space-y-4">
                    <!-- Day Banner Header -->
                    <div id="day-header-card" class="bg-gradient-to-br from-slate-900 via-blue-950 to-indigo-950 text-white rounded-2xl p-5 shadow-lg relative overflow-hidden">
                        <!-- Populated via JS -->
                    </div>

                    <!-- Day 2 Alternative Switcher (Hidden on other days) -->
                    <div id="day2-switcher" class="hidden bg-amber-50 border-2 border-amber-300 rounded-2xl p-4 shadow-sm">
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                            <div>
                                <h3 class="font-extrabold text-amber-950 text-sm sm:text-base flex items-center gap-2">
                                    <i class="fa-solid fa-code-branch text-amber-600"></i>
                                    <span>בחירת חלופה ליום השני (שני, 9.11):</span>
                                </h3>
                                <p class="text-xs text-amber-800 mt-0.5">החלף בין שתי התוכניות המלאות שבנינו ליום זה – הציר והמפה יתעדכנו מיידית</p>
                            </div>
                            <div class="flex bg-white p-1 rounded-xl border border-amber-300 shadow-inner">
                                <button onclick="setDay2Option('A')" id="btn-day2-A" class="px-3 py-1.5 rounded-lg text-xs font-bold transition-all">
                                    חלופה א': פארק לצ'וורת' (הגרנד קניון)
                                </button>
                                <button onclick="setDay2Option('B')" id="btn-day2-B" class="px-3 py-1.5 rounded-lg text-xs font-bold transition-all">
                                    חלופה ב': ארץ האמיש ואליקוטוויל
                                </button>
                            </div>
                        </div>
                        <!-- Quick Comparison Table -->
                        <div class="mt-3 pt-3 border-t border-amber-200/80 grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
                            <div class="bg-white/80 p-2.5 rounded-xl border border-amber-200">
                                <span class="font-bold text-blue-900">🌊 חלופה א' (לצ'וורת'):</span> קניון נהר הג'נסי, 3 מפלים אדירים, גשר הרכבת ושופינג אחה"צ בבאפלו (Marshalls / Ross).
                            </div>
                            <div class="bg-white/80 p-2.5 rounded-xl border border-amber-200">
                                <span class="font-bold text-emerald-900">🐎 חלופה ב' (האמיש):</span> כרכרות סוסים וחנויות עץ/קווילט במזומן ב-Leon ו-Conewango, ושיטוט בעיירה אליקוטוויל.
                            </div>
                        </div>
                    </div>

                    <!-- Action Bar: Google Maps Route & Add Custom Stop -->
                    <div class="bg-white p-3.5 rounded-2xl shadow-sm border border-slate-200 flex flex-wrap items-center justify-between gap-3">
                        <div class="flex items-center gap-2">
                            <span class="w-8 h-8 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center font-bold text-sm" id="stops-count-circle">0</span>
                            <div>
                                <div class="text-xs font-bold text-slate-800">תחנות במסלול היום</div>
                                <div class="text-[11px] text-slate-500">חיצים לשינוי סדר • ניווט ישיר ב-Google Maps וב-Waze</div>
                            </div>
                        </div>
                        <div class="flex flex-wrap items-center gap-2 w-full sm:w-auto justify-end">
                            <button onclick="toggleMobileDrawer(true)" class="lg:hidden flex-1 sm:flex-initial inline-flex items-center justify-center gap-1.5 px-3.5 py-2.5 rounded-xl text-xs font-bold bg-indigo-50 text-indigo-700 border border-indigo-200 hover:bg-indigo-100">
                                <i class="fa-solid fa-wand-magic-sparkles"></i>
                                <span>מגירת אטרקציות (<span id="mobile-drawer-count">16</span>)</span>
                            </button>
                            <a id="waze-day-link" href="#" target="_blank" rel="noopener noreferrer" class="hidden flex-1 sm:flex-initial inline-flex items-center justify-center gap-2 px-3.5 py-2.5 rounded-xl text-xs sm:text-sm font-bold bg-sky-500 hover:bg-sky-600 text-white shadow-md shadow-sky-500/20 transition-all">
                                <i class="fa-brands fa-waze text-base"></i>
                                <span>נווט ב-Waze לתחנה הראשונה</span>
                            </a>
                            <a id="google-maps-day-link" href="#" target="_blank" rel="noopener noreferrer" class="flex-1 sm:flex-initial inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold bg-emerald-600 hover:bg-emerald-700 text-white shadow-md shadow-emerald-600/20 transition-all">
                                <i class="fa-solid fa-location-arrow"></i>
                                <span>פתח מסלול יומי ב-Google Maps</span>
                            </a>
                        </div>
                    </div>

                    <!-- Timeline Items List -->
                    <div id="timeline-container" class="relative timeline-line space-y-3.5 pr-1">
                        <!-- Populated via JS -->
                    </div>

                    <!-- Day Logistics, Subway & Shopping Boxes -->
                    <div id="day-extras-container" class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
                        <!-- Populated via JS -->
                    </div>
                </div>

                <!-- Left Column: Smart Attractions Drawer (Desktop Sticky + Mobile Slide-over) -->
                <aside id="smart-drawer- wrapper" class="lg:col-span-5 xl:col-span-4 lg:sticky lg:top-20">
                    <div id="smart-drawer-panel" class="fixed inset-0 z-50 lg:static lg:z-auto hidden lg:block bg-slate-900/60 lg:bg-transparent backdrop-blur-xs lg:backdrop-blur-none">
                        <div class="bg-white w-full max-w-md lg:max-w-none h-full lg:h-auto mr-auto lg:mr-0 flex flex-col lg:rounded-2xl shadow-2xl lg:shadow-sm border border-slate-200 overflow-hidden">
                            
                            <!-- Drawer Header -->
                            <div class="bg-gradient-to-l from-indigo-950 to-slate-900 text-white p-4 flex items-center justify-between">
                                <div class="flex items-center gap-2.5">
                                    <div class="w-9 h-9 rounded-xl bg-indigo-500/20 border border-indigo-400/30 flex items-center justify-center text-indigo-300">
                                        <i class="fa-solid fa-layer-group"></i>
                                    </div>
                                    <div>
                                        <h3 class="font-extrabold text-sm sm:text-base flex items-center gap-2">
                                            <span>מגירת אטרקציות נוספות</span>
                                            <span id="drawer-remaining-badge" class="bg-amber-400 text-slate-950 text-[11px] font-black px-2 py-0.5 rounded-full">16</span>
                                        </h3>
                                        <p class="text-[11px] text-indigo-200">אתרים מהמאגר שלך שאינם בלו"ז – מותאמים חכמה ליום הפעיל</p>
                                    </div>
                                </div>
                                <button onclick="toggleMobileDrawer(false)" class="lg:hidden w-8 h-8 rounded-lg bg-white/10 text-white flex items-center justify-center">
                                    <i class="fa-solid fa-xmark"></i>
                                </button>
                            </div>

                            <!-- Smart Filter Controls -->
                            <div class="p-3 bg-slate-50 border-b border-slate-200 space-y-2.5">
                                <div class="flex items-center justify-between gap-2">
                                    <button onclick="setDrawerFilter('recommended')" id="drawer-filter-rec" class="flex-1 py-1.5 px-2.5 rounded-xl text-xs font-bold bg-indigo-600 text-white shadow-xs transition-all">
                                        <i class="fa-solid fa-wand-magic-sparkles ml-1"></i>מומלץ ליום הפעיל
                                    </button>
                                    <button onclick="setDrawerFilter('all')" id="drawer-filter-all" class="flex-1 py-1.5 px-2.5 rounded-xl text-xs font-bold bg-white text-slate-700 border border-slate-200 hover:bg-slate-100 transition-all">
                                        כל האזורים (16)
                                    </button>
                                </div>
                                <div class="flex items-center gap-1 overflow-x-auto pb-0.5 text-[11px]">
                                    <button onclick="setDrawerArea('ALL')" class="drawer-area-btn px-2.5 py-1 rounded-lg font-semibold bg-slate-200 text-slate-800 whitespace-nowrap" data-area="ALL">הכל</button>
                                    <button onclick="setDrawerArea('Midtown')" class="drawer-area-btn px-2.5 py-1 rounded-lg font-semibold bg-white border border-slate-200 text-slate-600 whitespace-nowrap" data-area="Midtown">Midtown</button>
                                    <button onclick="setDrawerArea('Uptown')" class="drawer-area-btn px-2.5 py-1 rounded-lg font-semibold bg-white border border-slate-200 text-slate-600 whitespace-nowrap" data-area="Uptown">Uptown</button>
                                    <button onclick="setDrawerArea('Downtown')" class="drawer-area-btn px-2.5 py-1 rounded-lg font-semibold bg-white border border-slate-200 text-slate-600 whitespace-nowrap" data-area="Downtown">Downtown</button>
                                    <button onclick="setDrawerArea('Brooklyn')" class="drawer-area-btn px-2.5 py-1 rounded-lg font-semibold bg-white border border-slate-200 text-slate-600 whitespace-nowrap" data-area="Brooklyn">Brooklyn</button>
                                </div>
                            </div>

                            <!-- Smart Match Context Banner -->
                            <div id="drawer-smart-hint" class="px-3.5 py-2 bg-indigo-50/90 border-b border-indigo-100 text-xs text-indigo-950 flex items-start gap-2">
                                <i class="fa-solid fa-lightbulb text-amber-500 mt-0.5"></i>
                                <span id="drawer-smart-hint-text">מציג התאמות גיאוגרפיות חכמות ליום הנבחר.</span>
                            </div>

                            <!-- Drawer Items List -->
                            <div id="drawer-items-container" class="p-3 space-y-3 overflow-y-auto custom-scrollbar max-h-[calc(100vh-280px)] lg:max-h-[680px]">
                                <!-- Populated via JS -->
                            </div>
                        </div>
                    </div>
                </aside>

            </div>
        </section>

        <!-- TAB 2: KOSHER RESTAURANTS INDEX -->
        <section id="view-restaurants" class="hidden space-y-5">
            <!-- Header & Search/Filter Bar -->
            <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-200 space-y-4">
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                    <div>
                        <h2 class="text-xl font-black text-slate-900 flex items-center gap-2">
                            <i class="fa-solid fa-utensils text-emerald-600"></i>
                            <span>אינדקס המסעדות הכשרות ומוקדי האוכל בניו יורק (2026)</span>
                        </h2>
                        <p class="text-xs sm:text-sm text-slate-600 mt-0.5">כל המסעדות מקובץ הדרייב שלך + מוקדי האוכל והברים מרשימת Cool New York – מחולקים לפי אזורים עם תפריט פירוט נפתח ושיבוץ ישיר לימי הטיול</p>
                    </div>
                    <div class="relative w-full md:w-72">
                        <i class="fa-solid fa-magnifying-glass absolute right-3.5 top-3 text-slate-400 text-sm"></i>
                        <input type="text" id="rest-search-input" oninput="renderRestaurants()" placeholder="חיפוש מסעדה, מנה, רחוב או השגחה..." class="w-full pr-10 pl-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs sm:text-sm focus:outline-none focus:border-blue-500 focus:bg-white transition-all">
                    </div>
                </div>

                <!-- Sort Mode Bar: By Area vs By Distance from User/Hotel -->
                <div class="flex flex-wrap items-center justify-between gap-2 pt-3 border-t border-slate-100 bg-slate-50/70 p-2.5 rounded-xl">
                    <div class="flex flex-wrap items-center gap-2">
                        <span class="text-xs font-extrabold text-slate-700"><i class="fa-solid fa-sort ml-1 text-blue-600"></i>תצוגה ומיון:</span>
                        <button onclick="setRestSortMode('area')" id="rest-sort-area" class="px-3 py-1.5 rounded-xl text-xs font-bold bg-blue-600 text-white shadow-xs transition-all">
                            <i class="fa-solid fa-layer-group ml-1"></i>חלוקה לפי אזורים
                        </button>
                        <button onclick="setRestSortMode('distance_gps')" id="rest-sort-gps" class="px-3 py-1.5 rounded-xl text-xs font-bold bg-white text-slate-700 border border-slate-200 hover:bg-slate-100 transition-all">
                            <i class="fa-solid fa-location-crosshairs ml-1 text-emerald-600"></i>מיון לפי מרחק מהמיקום שלי (GPS)
                        </button>
                        <button onclick="setRestSortMode('distance_hotel')" id="rest-sort-hotel" class="px-3 py-1.5 rounded-xl text-xs font-bold bg-white text-slate-700 border border-slate-200 hover:bg-slate-100 transition-all">
                            <i class="fa-solid fa-hotel ml-1 text-amber-600"></i>מרחק מהמלון (W 46th St)
                        </button>
                    </div>
                    <span id="rest-gps-status" class="text-[11px] font-semibold text-slate-500">ניתן לשבץ כל מסעדה ישירות לימי הטיול (ימים 3–8)</span>
                </div>

                <!-- Filter Pills: Area & Dietary Type -->
                <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 pt-2 border-t border-slate-100">
                    <!-- Area Filters -->
                    <div class="flex items-center gap-1.5 overflow-x-auto w-full sm:w-auto pb-1 sm:pb-0">
                        <span class="text-xs font-bold text-slate-400 ml-1 whitespace-nowrap">אזור:</span>
                        <button onclick="setRestAreaFilter('ALL')" class="rest-area-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-slate-900 text-white whitespace-nowrap" data-area="ALL">כל ניו יורק</button>
                        <button onclick="setRestAreaFilter('Midtown')" class="rest-area-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-slate-100 text-slate-700 hover:bg-slate-200 whitespace-nowrap" data-area="Midtown">Midtown & Times Sq</button>
                        <button onclick="setRestAreaFilter('UWS')" class="rest-area-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-slate-100 text-slate-700 hover:bg-slate-200 whitespace-nowrap" data-area="UWS">Upper West Side</button>
                        <button onclick="setRestAreaFilter('UES')" class="rest-area-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-slate-100 text-slate-700 hover:bg-slate-200 whitespace-nowrap" data-area="UES">Upper East Side</button>
                        <button onclick="setRestAreaFilter('Downtown')" class="rest-area-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-slate-100 text-slate-700 hover:bg-slate-200 whitespace-nowrap" data-area="Downtown">Downtown / SoHo / LES</button>
                        <button onclick="setRestAreaFilter('Outer')" class="rest-area-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-slate-100 text-slate-700 hover:bg-slate-200 whitespace-nowrap" data-area="Outer">Brooklyn / Queens / Bronx</button>
                    </div>

                    <!-- Type Filters -->
