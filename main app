        function openCentralParkOnLiveMap() {
            switchMainTab("map");
            const sel = document.getElementById("map-day-select");
            if (sel) {
                sel.value = "CENTRAL_PARK";
                updateMapMarkers();
            }
        }

        // ==========================================
        // 10. INTERACTIVE LEAFLET MAP LOGIC (NO-403 CARTO VOYAGER + ESRI + GPS)
        // ==========================================
        const MAP_TILE_PROVIDERS = {
            voyager: {
                url: "https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png",
                options: {
                    attribution: '&copy; OpenStreetMap contributors &copy; CARTO',
                    subdomains: "abcd",
                    maxZoom: 20
                }
            },
            esri_street: {
                url: "https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}",
                options: {
                    attribution: 'Tiles &copy; Esri',
                    maxZoom: 19
                }
            },
            esri_sat: {
                url: "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
                options: {
                    attribution: 'Tiles &copy; Esri',
                    maxZoom: 19
                }
            }
        };

        function switchMapTileStyle(styleKey) {
            if (!leafletMap) return;
            const cfg = MAP_TILE_PROVIDERS[styleKey] || MAP_TILE_PROVIDERS.voyager;
            if (currentTileLayer) {
                leafletMap.removeLayer(currentTileLayer);
            }
            currentTileLayer = L.tileLayer(cfg.url, cfg.options).addTo(leafletMap);
        }

        function initOrUpdateMap() {
            if (!leafletMap) {
                leafletMap = L.map("map-container").setView([40.7558, -73.9813], 13);

                // Default to CartoDB Voyager (hosted on Fastly CDN - never returns 403 in iframes/previews and requires no API key)
                switchMapTileStyle("voyager");

                mapMarkersGroup = L.layerGroup().addTo(leafletMap);

                // Attempt passive user geolocation on first map load
                locateUserOnMap(false);
            }
            setTimeout(() => {
                leafletMap.invalidateSize();
                updateMapMarkers();
            }, 150);
        }

        function locateUserOnMap(panToUser) {
            if (!navigator.geolocation || !leafletMap) {
                if (panToUser) showToast("הדפדפן לא תומך בשירותי מיקום או שהגישה נחסמה.");
                return;
            }
            navigator.geolocation.getCurrentPosition(
                (pos) => {
                    const lat = pos.coords.latitude;
                    const lng = pos.coords.longitude;
                    const acc = pos.coords.accuracy || 50;

                    if (userLocationMarker) leafletMap.removeLayer(userLocationMarker);
                    if (userLocationCircle) leafletMap.removeLayer(userLocationCircle);

                    const userIcon = L.divIcon({
                        className: "user-gps-pin",
                        html: `<div style="width:20px;height:20px;border-radius:50%;background:#06b6d4;border:3px solid #ffffff;box-shadow:0 0 0 6px rgba(6,182,212,0.35), 0 2px 6px rgba(0,0,0,0.4);"></div>`,
                        iconSize: [20, 20],
                        iconAnchor: [10, 10]
                    });

                    userLocationCircle = L.circle([lat, lng], {
                        radius: Math.min(acc, 300),
                        color: "#06b6d4",
                        fillColor: "#22d3ee",
                        fillOpacity: 0.15,
                        weight: 1
                    }).addTo(leafletMap);

                    userLocationMarker = L.marker([lat, lng], { icon: userIcon, zIndexOffset: 1000 })
                        .bindPopup(`
                            <div dir="rtl" style="font-family:'Heebo',sans-serif;text-align:right;">
                                <div style="font-size:12px;font-weight:900;color:#0891b2;">📍 המיקום הנוכחי שלך</div>
                                <div style="font-size:11px;color:#475569;">דיוק משוער: כ-${Math.round(acc)} מטרים</div>
                            </div>
                        `)
                        .addTo(leafletMap);

                    if (panToUser) {
                        leafletMap.setView([lat, lng], 15);
                        userLocationMarker.openPopup();
                        showToast("המיקום שלך אותר והוצג על המפה!");
                    }
                },
                () => {
                    if (panToUser) showToast("לא ניתן לקבל מיקום – ודא שהרשאת המיקום (GPS) מאושרת בדפדפן.");
                },
                { enableHighAccuracy: true, timeout: 8000 }
            );
        }

        function createPinIcon(colorHex, labelText) {
            return L.divIcon({
                className: "custom-map-pin",
                html: `<div style="background:${colorHex};color:#fff;width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:900;font-size:11px;border:2.5px solid #fff;box-shadow:0 3px 8px rgba(0,0,0,0.35);">${labelText}</div>`,
                iconSize: [28, 28],
                iconAnchor: [14, 14]
            });
        }

        function updateMapMarkers() {
            if (!leafletMap || !mapMarkersGroup) return;
            mapMarkersGroup.clearLayers();
            if (mapPolyline) {
                leafletMap.removeLayer(mapPolyline);
                mapPolyline = null;
            }

            const filterVal = document.getElementById("map-day-select").value;
            const showAllNyc = document.getElementById("map-toggle-all-nyc")?.checked ?? true;
            const showRest = document.getElementById("map-toggle-rest").checked;
            const showDrawer = document.getElementById("map-toggle-drawer").checked;

            const boundsPoints = [];
            const routeCoords = [];
            const renderedIds = new Set();

            // Special Mode: Central Park Walking Tour
            if (filterVal === "CENTRAL_PARK") {
                const cpStops = getOrderedCentralParkStops();
                cpStops.forEach((s, idx) => {
                    const marker = L.marker([s.lat, s.lng], {
                        icon: createPinIcon("#059669", idx + 1)
                    });
                    const gUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(s.name + " Central Park")}`;
                    marker.bindPopup(`
                        <div dir="rtl" style="font-family:'Heebo',sans-serif;min-width:220px;">
                            <div style="font-size:11px;font-weight:800;color:#059669;">🍂 סיור סנטרל פארק • תחנה ${idx + 1}</div>
                            <div style="font-size:14px;font-weight:900;color:#0f172a;margin:2px 0;">${s.name}</div>
                            <div style="font-size:12px;color:#475569;margin-bottom:8px;">${s.desc}</div>
                            <a href="${gUrl}" target="_blank" style="display:inline-block;background:#059669;color:#fff;padding:4px 10px;border-radius:8px;font-size:11px;font-weight:700;text-decoration:none;">פתח ב-Google Maps</a>
                        </div>
                    `);
                    mapMarkersGroup.addLayer(marker);
                    boundsPoints.push([s.lat, s.lng]);
                    routeCoords.push([s.lat, s.lng]);
                });
                if (routeCoords.length > 1) {
                    mapPolyline = L.polyline(routeCoords, { color: "#059669", weight: 4, opacity: 0.85, dashArray: "6, 6" }).addTo(leafletMap);
                }
                if (boundsPoints.length > 0) leafletMap.fitBounds(boundsPoints, { padding: [35, 35], maxZoom: 16 });
                return;
            }

            // 1. Add Active Day(s) Stops
            let daysToRender = [];
            if (filterVal === "ALL_NYC") daysToRender = [3, 4, 5, 6, 7, 8];
            else if (filterVal === "NIAGARA") daysToRender = [1, 2];
            else daysToRender = [parseInt(filterVal, 10)];

            const isNiagaraMode = (filterVal === "NIAGARA" || filterVal === "1" || filterVal === "2");

            daysToRender.forEach(dNum => {
                const stops = appState.daysData[dNum]?.stops || [];
                stops.forEach((s, idx) => {
                    if (!s.lat || !s.lng) return;
                    renderedIds.add(s.id);
                    const marker = L.marker([s.lat, s.lng], {
                        icon: createPinIcon("#2563eb", daysToRender.length === 1 ? (idx + 1) : `י${dNum}`)
                    });
                    const gUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(s.name + " " + s.address)}`;
                    const wazeUrl = buildWazeUrl(s);
                    marker.bindPopup(`
                        <div dir="rtl" style="font-family:'Heebo',sans-serif;min-width:220px;">
                            <div style="font-size:11px;font-weight:800;color:#2563eb;">משובץ ביום ${dNum} • תחנה ${idx + 1} (${s.time})</div>
                            <div style="font-size:14px;font-weight:900;color:#0f172a;margin:2px 0;">${s.name}</div>
                            <div style="font-size:12px;color:#475569;margin-bottom:8px;">${s.desc}</div>
                            <div style="display:flex;gap:6px;">
                                <a href="${gUrl}" target="_blank" style="display:inline-block;background:#10b981;color:#fff;padding:4px 10px;border-radius:8px;font-size:11px;font-weight:700;text-decoration:none;">Google Maps</a>
                                ${dNum <= 3 ? `<a href="${wazeUrl}" target="_blank" style="display:inline-block;background:#0ea5e9;color:#fff;padding:4px 10px;border-radius:8px;font-size:11px;font-weight:700;text-decoration:none;">Waze</a>` : ''}
                            </div>
                        </div>
                    `);
                    mapMarkersGroup.addLayer(marker);
                    boundsPoints.push([s.lat, s.lng]);
                    if (daysToRender.length === 1) routeCoords.push([s.lat, s.lng]);
                });
            });

            // Draw polyline if single day selected
            if (routeCoords.length > 1) {
                mapPolyline = L.polyline(routeCoords, {
                    color: "#2563eb",
                    weight: 4,
                    opacity: 0.75,
                    dashArray: "8, 8"
                }).addTo(leafletMap);
            }

            // 2. Render ALL NYC Attractions from Unified Master DB (even when viewing a specific NYC day)
            if (!isNiagaraMode) {
                MASTER_NYC_ATTRACTIONS_DB.forEach(item => {
                    if (!item.lat || !item.lng) return;
                    if (renderedIds.has(item.id)) return; // Already drawn as part of current day filter

                    const scheduledDay = isAttractionScheduledInTrip(item);
                    if (scheduledDay && !showAllNyc) return;
                    if (!scheduledDay && !showDrawer) return;

                    const pinColor = scheduledDay ? "#1d4ed8" : "#4f46e5";
                    const pinLabel = scheduledDay ? `י${scheduledDay}` : "✨";
                    const statusText = scheduledDay
                        ? `משובץ ביום ${scheduledDay} (${appState.daysData[scheduledDay].shortTitle})`
                        : `אטרקציה פנויה במגירה (${item.area})`;

                    const gUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(item.name + " " + item.address)}`;
                    const marker = L.marker([item.lat, item.lng], {
                        icon: createPinIcon(pinColor, pinLabel)
                    });
                    marker.bindPopup(`
                        <div dir="rtl" style="font-family:'Heebo',sans-serif;min-width:210px;">
                            <div style="font-size:11px;font-weight:800;color:${pinColor};">${statusText}</div>
                            <div style="font-size:14px;font-weight:900;color:#0f172a;margin:2px 0;">${item.name}</div>
                            <div style="font-size:12px;color:#475569;margin-bottom:6px;">${item.desc}</div>
                            <a href="${gUrl}" target="_blank" style="display:inline-block;background:#2563eb;color:#fff;padding:4px 10px;border-radius:8px;font-size:11px;font-weight:700;text-decoration:none;">פתח ב-Google Maps</a>
                        </div>
                    `);
                    mapMarkersGroup.addLayer(marker);
                    if (filterVal === "ALL_NYC") boundsPoints.push([item.lat, item.lng]);
                });
            }

            // 3. Add Kosher Restaurants (if in NYC view)
            if (showRest && !isNiagaraMode) {
                KOSHER_RESTAURANTS.forEach(r => {
                    if (!r.lat || !r.lng) return;
                    let color = "#dc2626"; // Meat
                    if (r.type === "חלבי") color = "#0284c7";
                    else if (r.type === "פרווה") color = "#059669";
                    else if (r.type === "בר") color = "#7c3aed";

                    const marker = L.marker([r.lat, r.lng], {
                        icon: createPinIcon(color, "🍴")
                    });
                    marker.bindPopup(`
                        <div dir="rtl" style="font-family:'Heebo',sans-serif;min-width:210px;">
                            <div style="font-size:11px;font-weight:800;color:${color};">${r.type} • ${r.kashrut}</div>
                            <div style="font-size:14px;font-weight:900;color:#0f172a;margin:2px 0;">${r.name}</div>
                            <div style="font-size:12px;color:#475569;"><b>מומלץ:</b> ${r.dishes}</div>
                            <div style="font-size:11px;color:#64748b;margin-top:4px;">${r.address}</div>
                        </div>
                    `);
                    mapMarkersGroup.addLayer(marker);
                });
            }

            if (boundsPoints.length > 0) {
                leafletMap.fitBounds(boundsPoints, { padding: [35, 35], maxZoom: 15 });
            }
        }

        // ==========================================
        // 11. CHECKLIST, TABS & MODAL HELPERS
        // ==========================================
        function renderChecklist() {
            const container = document.getElementById("checklist-container");
            const doneCount = appState.checklist.filter(c => c.done).length;
            document.getElementById("checklist-progress").textContent = `${doneCount}/${appState.checklist.length} הושלמו`;

            container.innerHTML = appState.checklist.map(item => `
                <label class="flex items-center gap-2.5 p-3 rounded-xl border cursor-pointer transition-all ${
                    item.done ? "bg-emerald-50/70 border-emerald-200 text-emerald-950" : "bg-slate-50 border-slate-200 text-slate-700 hover:bg-slate-100"
                }">
                    <input type="checkbox" ${item.done ? "checked" : ""} onchange="toggleChecklistItem('${item.id}')" class="w-4 h-4 rounded text-emerald-600 focus:ring-0">
                    <span class="text-xs font-semibold ${item.done ? "line-through opacity-75" : ""}">${item.text}</span>
                </label>
            `).join('');
        }

        function toggleChecklistItem(id) {
            const item = appState.checklist.find(c => c.id === id);
            if (item) {
                item.done = !item.done;
                saveState();
                renderChecklist();
            }
        }

        function switchMainTab(tabName) {
            appState.activeMainTab = tabName;
            ["itinerary", "restaurants", "map", "centralpark", "guide"].forEach(t => {
                const viewEl = document.getElementById(`view-${t}`);
                const btnEl = document.getElementById(`tab-btn-${t}`);
                if (!viewEl || !btnEl) return;
                if (t === tabName) {
                    viewEl.classList.remove("hidden");
                    btnEl.className = "main-tab-btn flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs sm:text-sm font-bold transition-all whitespace-nowrap bg-blue-600 text-white shadow-md shadow-blue-600/30";
                } else {
                    viewEl.classList.add("hidden");
                    btnEl.className = "main-tab-btn flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs sm:text-sm font-bold transition-all whitespace-nowrap bg-slate-800/80 text-slate-300 hover:bg-slate-800";
                }
            });

            if (tabName === "map") {
                initOrUpdateMap();
            } else if (tabName === "centralpark") {
                renderCentralParkTab();
            }
        }

        function openResetModal() {
            document.getElementById("reset-modal").classList.remove("hidden");
        }

        function closeResetModal() {
            document.getElementById("reset-modal").classList.add("hidden");
        }

        function confirmResetApp() {
            localStorage.removeItem(STORAGE_KEY);
            resetToDefaultData();
            closeResetModal();
            renderDaySelector();
            renderActiveDayView();
            renderSmartDrawer();
            renderRestaurants();
            renderChecklist();
            showToast("האפליקציה אופסה לתוכנית 8 הימים המקורית!");
        }

        let toastTimeout = null;
        function showToast(msg) {
            const box = document.getElementById("toast-box");
            document.getElementById("toast-message").textContent = msg;
            box.classList.remove("hidden");
            if (toastTimeout) clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
                box.classList.add("hidden");
            }, 3200);
        }

        // Initialize application on load
        window.onload = function () {
            initAppState();
            renderDaySelector();
            renderActiveDayView();
            renderSmartDrawer();
            renderRestaurants();
            renderCentralParkTab();
            renderChecklist();
        };
    </script>
</body>
</html>
