                    appState.daysData = parsed.daysData || JSON.parse(JSON.stringify(DEFAULT_DAYS_DATA));
                    appState.day2Option = parsed.day2Option || "A";
                    appState.checklist = parsed.checklist || JSON.parse(JSON.stringify(DEFAULT_CHECKLIST));
                } else {
                    resetToDefaultData();
                }
            } catch (e) {
                resetToDefaultData();
            }
            syncDay2Data();
            appState.drawerItems = getUnscheduledDrawerAttractions();
        }

        function resetToDefaultData() {
            appState.daysData = JSON.parse(JSON.stringify(DEFAULT_DAYS_DATA));
            appState.day2Option = "A";
            appState.checklist = JSON.parse(JSON.stringify(DEFAULT_CHECKLIST));
            syncDay2Data();
            appState.drawerItems = getUnscheduledDrawerAttractions();
            saveState();
