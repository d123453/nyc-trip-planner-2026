            } else {
                btnN2S.className = "px-3.5 py-2 rounded-xl text-xs font-bold transition-all bg-amber-400 text-slate-950 shadow-sm";
                btnS2N.className = "px-3.5 py-2 rounded-xl text-xs font-bold transition-all text-white hover:bg-white/10";
