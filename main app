        }

        function renderRestaurants() {
            const searchVal = (document.getElementById("rest-search-input")?.value || "").trim().toLowerCase();
            const container = document.getElementById("restaurants-list-container");
            if (!container) return;

            let filtered = KOSHER_RESTAURANTS.filter(r => {
                if (appState.restAreaFilter !== "ALL" && r.area !== appState.restAreaFilter) return false;
                if (appState.restTypeFilter !== "ALL" && r.type !== appState.restTypeFilter) return false;
                if (searchVal) {
                    const hay = `${r.name} ${r.cuisine} ${r.kashrut} ${r.address} ${r.dishes} ${r.notes}`.toLowerCase();
                    if (!hay.includes(searchVal)) return false;
                }
                return true;
            });

            document.getElementById("rest-count-badge").textContent = filtered.length;

            if (filtered.length === 0) {
                container.innerHTML = `
                    <div class="bg-white p-8 rounded-2xl text-center text-slate-500 border border-slate-200">
                        לא נמצאו מסעדות התואמות את הסינון הנוכחי. נסה לאפס את החיפוש.
                    </div>
                `;
                return;
            }

            // Sort by Distance Mode (GPS or Hotel)
            if (appState.restSortMode === "distance_gps" || appState.restSortMode === "distance_hotel") {
                const refCoords = (appState.restSortMode === "distance_gps" && appState.userCoords)
                    ? appState.userCoords
                    : HOTEL_COORDS;
                const refLabel = (appState.restSortMode === "distance_gps" && appState.userCoords)
                    ? "ממך"
                    : "מהמלון";

                const withDist = filtered.map(r => ({
                    rest: r,
                    distKm: calcDistanceKm(refCoords.lat, refCoords.lng, r.lat, r.lng)
                })).sort((a, b) => a.distKm - b.distKm);

                container.innerHTML = `
                    <div class="space-y-3">
                        ${withDist.map(item => renderRestaurantCardHtml(item.rest, item.distKm, refLabel)).join('')}
                    </div>
                `;
                return;
            }

            // Default: Group by Area
            const areaGroups = [
                { key: "Midtown", title: "Midtown & Times Square (סביב המלון ומרכז מנהטן)" },
                { key: "UWS", title: "Upper West Side (ליד מוזיאון הטבע וסנטרל פארק)" },
                { key: "UES", title: "Upper East Side (ליד המטרופוליטן ולקסינגטון)" },
                { key: "Downtown", title: "Downtown, SoHo, Chinatown, LES & Wall Street" },
                { key: "Outer", title: "Brooklyn, Queens & The Bronx" }
            ];

            container.innerHTML = areaGroups.map(grp => {
                const grpItems = filtered.filter(r => r.area === grp.key);
                if (grpItems.length === 0) return "";
                return `
                    <div class="space-y-3">
                        <div class="flex items-center justify-between px-1">
                            <h3 class="text-sm sm:text-base font-black text-slate-800 flex items-center gap-2">
                                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                                <span>${grp.title}</span>
                            </h3>
                            <span class="text-xs font-bold text-slate-500">${grpItems.length} מקומות</span>
                        </div>
                        <div class="grid grid-cols-1 lg:grid-cols-2 gap-3">
                            ${grpItems.map(r => {
                                const dHotel = calcDistanceKm(HOTEL_COORDS.lat, HOTEL_COORDS.lng, r.lat, r.lng);
                                return renderRestaurantCardHtml(r, dHotel, "מהמלון");
                            }).join('')}
                        </div>
                    </div>
                `;
            }).join('');
        }

        function addRestaurantToDay(restId) {
            const r = KOSHER_RESTAURANTS.find(x => x.id === restId);
            if (!r) return;
            const sel = document.getElementById(`rest-day-select-${restId}`);
            const targetDay = sel ? parseInt(sel.value, 10) : Math.max(3, appState.activeDay);

            const newStop = {
                id: `rest-${r.id}-${Date.now()}`,
                time: "ארוחה משובצת",
                name: `${r.name} (${r.type} - ${r.kashrut})`,
                type: `מסעדה (${r.type})`,
                address: r.address,
                lat: r.lat,
                lng: r.lng,
                desc: `${r.cuisine}. מנות מומלצות: ${r.dishes}. שעות פעילות: ${r.hours}.`,
                cost: r.rating,
                tags: [r.type, r.kashrut, "נוסף מאינדקס המסעדות"],
