            const activeCls = "px-3 py-1.5 rounded-xl text-xs font-bold bg-blue-600 text-white shadow-xs transition-all";
            const idleCls = "px-3 py-1.5 rounded-xl text-xs font-bold bg-white text-slate-700 border border-slate-200 hover:bg-slate-100 transition-all";

            btnArea.className = mode === "area" ? activeCls : idleCls;
            btnGps.className = mode === "distance_gps" ? activeCls : idleCls;
            btnHotel.className = mode === "distance_hotel" ? activeCls : idleCls;

            if (mode === "distance_gps") {
