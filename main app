                        appState.userCoords = { lat: pos.coords.latitude, lng: pos.coords.longitude };
                        appState.restSortMode = "distance_gps";
                        // Check if user is currently outside NYC (>80km away, e.g. in Israel)
                        const distToManhattan = calcDistanceKm(appState.userCoords.lat, appState.userCoords.lng, HOTEL_COORDS.lat, HOTEL_COORDS.lng);
                        if (distToManhattan > 80) {
                            statusEl.innerHTML = `<span class="text-amber-700">📍 ממוין לפי ה-GPS שלך (אתה כרגע מחוץ לניו יורק – לחץ על "מרחק מהמלון" למדידה בתוך מנהטן)</span>`;
