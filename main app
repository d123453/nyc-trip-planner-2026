        function syncDay2Data() {
            const opt = DAY2_OPTIONS[appState.day2Option];
            // Keep any extra items added by user to Day 2, or load option stops
            const userAdded = (appState.daysData[2]?.stops || []).filter(s => s.isFromDrawer);
            appState.daysData[2].title = opt.title;
            appState.daysData[2].summaryQuote = opt.summaryQuote;
            appState.daysData[2].logisticsTips = [...opt.logisticsTips];
            appState.daysData[2].shoppingTips = [...opt.shoppingTips];
            appState.daysData[2].stops = [...JSON.parse(JSON.stringify(opt.stops)), ...userAdded];
        }

        function saveState() {
            try {
                appState.drawerItems = getUnscheduledDrawerAttractions();
                localStorage.setItem(STORAGE_KEY, JSON.stringify({
                    daysData: appState.daysData,
                    day2Option: appState.day2Option,
                    drawerItems: appState.drawerItems,
                    checklist: appState.checklist
                }));
            } catch (e) {
