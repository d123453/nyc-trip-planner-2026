        // ==========================================
        // 9B. CENTRAL PARK WALKING TOUR LOGIC
        // ==========================================
        function getOrderedCentralParkStops() {
            if (appState.centralParkRoute === "SOUTH_TO_NORTH") {
                // Route 1: From 6th Ave (cp-1) to Strawberry Fields (cp-9)
                return CENTRAL_PARK_STOPS_S2N.filter(s => s.id !== "cp-10");
            } else {
                // Route 2 (Shabbat): From Strawberry Fields (cp-9) down to Grand Army Plaza on 5th Ave (cp-10)
                const n2sOrder = ["cp-9", "cp-8", "cp-7", "cp-6", "cp-5", "cp-4", "cp-3", "cp-2", "cp-10"];
                return n2sOrder.map(id => CENTRAL_PARK_STOPS_S2N.find(s => s.id === id)).filter(Boolean);
            }
        }

        function setCentralParkRoute(routeMode) {
            appState.centralParkRoute = routeMode;
            const btnS2N = document.getElementById("cp-btn-s2n");
            const btnN2S = document.getElementById("cp-btn-n2s");
